{
	"name": "roamarr",
	"private": true,
	"version": "0.42.0",
	"license": "GPL-3.0-only",
	"type": "module",
	"engines": {
		"node": ">=24.15.0"
	},
	"scripts": {
		"dev": "node --env-file-if-exists=.env ./node_modules/vite/bin/vite.js dev",
		"build": "vite build",
		"start": "node --env-file-if-exists=.env build",
		"preview": "node --env-file-if-exists=.env ./node_modules/vite/bin/vite.js preview",
		"postinstall": "patch-package",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "node tests/e2e/prepare.mjs && playwright test",
		"test:e2e:ui": "node tests/e2e/prepare.mjs && playwright test --ui",
		"test:e2e:install": "playwright install chromium",
		"credits:generate": "node scripts/generate-license-data.mjs",
		"version:bump": "node scripts/bump-version.mjs",
		"db:seed": "node --env-file-if-exists=.env --experimental-strip-types --import ./scripts/seed-alias-loader.mjs scripts/seed-database.mjs",
		"db:compat-fixture": "node --experimental-strip-types --import ./scripts/seed-alias-loader.mjs scripts/generate-compat-fixture.mjs"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/jsdom": "^30.0.0",
		"@types/luxon": "^3.7.6",
		"@types/mailparser": "^3.9.0",
		"@types/nodemailer": "^8.0.2",
		"@types/qrcode": "^1.5.6",
		"@types/unzipper": "^0.10.11",
		"@typescript/native": "npm:typescript@^7.0.2",
		"axe-core": "^4.14.0",
		"jsdom": "^30.1.3",
		"patch-package": "^8.0.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@huggingface/transformers": "^4.3.2",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"@node-rs/argon2": "^2.2.2",
		"@simplewebauthn/browser": "^14.0.0",
		"@simplewebauthn/server": "^14.0.3",
		"@visorcraft/mongreldb": "^0.65.0",
		"@visorcraft/mongreldb-kit": "^0.65.0",
		"gridjs": "^6.2.0",
		"imapflow": "^2.10.0",
		"luxon": "^3.7.2",
		"mailparser": "^3.14.1",
		"maplibre-gl": "^6.16.0",
		"nodemailer": "^10.3.1",
		"otpauth": "^9.5.2",
		"qrcode": "^1.5.4",
		"tar-fs": "^3.1.3",
		"three": "^0.186.1",
		"unzipper": "^0.12.5"
	},
	"allowScripts": {
		"onnxruntime-node@1.30.0": true
	}
}
